<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Лидеры</title><link rel="stylesheet" href="/style.css"></head><body><div class="app-shell"><div class="app-topbar"><a class="app-home" href="/">← Главная</a><h1>🏆 Таблица лидеров</h1></div><div class="app-card"><div id="leaders" class="app-list"></div></div></div><script src="/account.js"></script><script>apiJson('/api/leaderboard').then(data=>{leaders.innerHTML=data.leaders.map((u,i)=>`<div class="app-row"><strong>${i+1}. ${u.name}</strong><span>Ур. ${u.level} · ${u.xp} XP · 🔥 ${u.streak} · 📘 ${u.learnedWords}</span></div>`).join('')||'Пока нет участников'})</script></body></html>
