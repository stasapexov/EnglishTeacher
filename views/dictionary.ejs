<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Мой словарь</title><link rel="stylesheet" href="/style.css"></head>
<body>
<div class="app-shell" id="dictApp">
    <div class="app-topbar"><a class="app-home" href="/">← Главная</a><h1>📘 Мой словарь</h1><a class="app-home" href="/review">Повторение</a></div>
    <section class="app-card">
        <h2>Добавить слово</h2>
        <input class="app-input" id="word" placeholder="word">
        <input class="app-input" id="translation" placeholder="перевод">
        <button class="app-btn" id="add">Добавить</button>
        <select class="app-select" id="filter"><option value="">Все</option><option value="new">Новые</option><option value="review">На повторение</option><option value="learned">Выученные</option></select>
    </section>
    <div id="words" class="app-list"></div>
</div>
<script src="/account.js"></script>
<script>
const root = document.getElementById('dictApp')
if (requireLogin(root)) loadWords()
document.getElementById('filter').addEventListener('change', loadWords)
document.getElementById('add').addEventListener('click', async () => {
    await apiJson('/api/dictionary', { method:'POST', body: JSON.stringify({ word: word.value, translation: translation.value }) })
    word.value = ''; translation.value = ''; loadWords()
})
async function loadWords(){
    const status = document.getElementById('filter').value
    const data = await apiJson('/api/dictionary' + (status ? `?status=${status}` : ''))
    document.getElementById('words').innerHTML = data.words.length ? data.words.map(w => `
        <section class="app-card">
            <div class="app-row"><h3>${w.word}</h3><span class="badge">${w.status}</span></div>
            <p>${w.translation || 'перевод не указан'}</p>
            <p class="app-muted">Повторений: ${w.repetitions} · Верно: ${w.correct} · Ошибок: ${w.wrong} · Следующее: ${formatDate(w.nextReviewAt)}</p>
            <button class="app-btn secondary" onclick="markLearned('${w.id}')">Выучено</button>
            <button class="app-btn danger" onclick="removeWord('${w.id}')">Удалить</button>
        </section>`).join('') : '<section class="app-card empty-state">Слов пока нет. Добавьте слово вручную или из Reading Room.</section>'
}
async function markLearned(id){ await apiJson('/api/dictionary/'+id,{method:'PATCH', body:JSON.stringify({status:'learned'})}); loadWords() }
async function removeWord(id){ await apiJson('/api/dictionary/'+id,{method:'DELETE'}); loadWords() }
</script>
</body>
</html>
