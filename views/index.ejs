    <!-- РЕГИСТРАЦИЯ И ВХОД ЧЕРЕЗ JSON API -->
    <section class="auth-card" id="authSection">
        <div class="auth-copy">
            <h2>🔐 Личный кабинет</h2>
            <p>Зарегистрируйся или войди в аккаунт. Данные отправляются на сервер в формате JSON, а пользователи сохраняются в локальном файле <strong>data/users.json</strong>.</p>
        </div>

        <div class="auth-form" id="authFormBox">
            <div class="auth-tabs">
                <button type="button" class="auth-tab active" data-mode="login">Вход</button>
                <button type="button" class="auth-tab" data-mode="register">Регистрация</button>
            </div>
            <form id="authForm">
                <input class="auth-field" id="authName" name="name" type="text" placeholder="Имя" autocomplete="name" hidden>
                <input class="auth-field" id="authEmail" name="email" type="email" placeholder="Email" autocomplete="email" required>
                <input class="auth-field" id="authPassword" name="password" type="password" placeholder="Пароль" autocomplete="current-password" required minlength="6">
                <button class="auth-submit" id="authSubmit" type="submit">Войти</button>
            </form>
            <div class="auth-status" id="authStatus"></div>
        </div>

        <div class="user-card" id="userCard" hidden>
            <strong id="userName">Пользователь</strong>
            <span id="userEmail">email@example.com</span>
            <button class="logout-btn" id="logoutBtn" type="button">Выйти</button>
        </div>
    </section>


    <!-- СЕКЦИЯ ИГР -->
    <div class="section-title">
        <span></span> 🎲 Игровой центр
    </div>
    <div class="games-grid">
        <a href="/learn" class="menu-item" data-color="learn">
            <div class="menu-icon">📘</div>
            <div class="menu-title">Домашнее задание</div>
