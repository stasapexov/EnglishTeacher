        </a>
    </div>



    <div class="section-title">
        <span></span> 🚀 Личные инструменты
    </div>
    <div class="games-grid">
        <a href="/profile" class="menu-item"><div class="menu-icon">👤</div><div class="menu-title">Профиль</div><div class="menu-desc">XP, streak, задания, достижения</div></a>
        <a href="/dictionary" class="menu-item"><div class="menu-icon">📘</div><div class="menu-title">Мой словарь</div><div class="menu-desc">Сохраняй и фильтруй слова</div></a>
        <a href="/review" class="menu-item"><div class="menu-icon">🔁</div><div class="menu-title">Повторение</div><div class="menu-desc">Интервальная система запоминания</div></a>
        <a href="/placement" class="menu-item"><div class="menu-icon">🎯</div><div class="menu-title">Тест уровня</div><div class="menu-desc">A1–C1 и персональный старт</div></a>
        <a href="/grammar" class="menu-item"><div class="menu-icon">🧩</div><div class="menu-title">Грамматика</div><div class="menu-desc">Правила + интерактивные ответы</div></a>
        <a href="/pronunciation" class="menu-item"><div class="menu-icon">🎙️</div><div class="menu-title">Произношение</div><div class="menu-desc">Озвучка и запись речи</div></a>
        <a href="/leaderboard" class="menu-item"><div class="menu-icon">🏆</div><div class="menu-title">Лидеры</div><div class="menu-desc">Рейтинг по уровню, XP и streak</div></a>
        <a href="/book-trial" class="menu-item"><div class="menu-icon">🧠</div><div class="menu-title">Book Trial AI</div><div class="menu-desc">Устная защита книги с бесплатной AI-оценкой</div></a>
    </div>

    <!-- ОТДЕЛЬНОЕ ПРОСТРАНСТВО: READING ROOM (ЧТЕНИЕ КНИГ) -->
    <div class="reading-section">
        <div class="reading-header">
            <p>📖</p>
            <h2>Reading Room</h2>
            <div class="feature-badge">Новый формат</div>
        </div>
        <div class="reading-card">
            <div class="reading-info">
                <p><strong>✨ Погружение в мир английской литературы</strong> — учи язык через увлекательное чтение.</p>
                <ul class="feature-list">
                    <li><strong>Выбор книг</strong> — от классики до современных бестселлеров, адаптированные под ваш уровень.</li>
                    <li><strong>Интерактивный перевод</strong> — нажми на любое незнакомое слово, и мгновенно появится перевод, транскрипция и пример использования.</li>
                    <li><strong>Словарь на лету</strong> — сохраняй слова в личный набор для повторения.</li>
                    <li><strong>Аудиосопровождение</strong> — слушай профессиональное озвучивание отрывков (опционально).</li>
                </ul>
                <a href="/reader" class="cta-button">📚 Перейти в библиотеку →</a>
                <a href="/book-trial" class="cta-button">🧠 Пройти Book Trial AI →</a>
            </div>
            <div class="book-preview">
                <div class="book-cover">📘✨</div>
                <div class="book-title"><strong>Robinson Crusoe</strong></div>
                <div class="demo-translate">💡 Нажми на слово <span style="background:#e2e8f0; padding:2px 6px; border-radius:12px;">Sea</span> → перевод: <strong>(Море)</strong></div>
                <div style="margin-top: 10px; font-size: 0.7rem; color:#64748b;">* Функция перевода по клику доступна в читалке</div>
            </div>
        </div>
        <div style="margin-top: 1rem; font-size: 0.8rem; color:#475569; background: rgba(255,255,240,0.6); border-radius: 40px; padding: 8px 14px; text-align: center;">
            🧠 Книги с умным переводчиком — учись, читая с удовольствием!
        </div>
    </div>

    <div class="inspire-message">
        💡 <span>Тренируйся каждый день</span> — выполняй задания, получай опыт и повышай уровень!
    </div>
</div>

<script>
    (function() {
        // ========== XP И УРОВНИ (чистый дизайн, но я оставлю минимальную работу XP, чтобы панель была живой) ==========
        const xpSpan = document.getElementById('xp');
        const levelSpan = document.getElementById('level');
        const getXpNeeded = (lvl) => 80 + (lvl - 1) * 55;
        let currentXP = 0, currentLevel = 1;

        function loadProgress() {
            try {
                const savedXP = localStorage.getItem('englishTrainer_xp');
                const savedLevel = localStorage.getItem('englishTrainer_level');
                if (savedXP !== null && !isNaN(parseInt(savedXP))) currentXP = parseInt(savedXP);
                if (savedLevel !== null && !isNaN(parseInt(savedLevel))) currentLevel = parseInt(savedLevel);
                recalc();
            } catch(e) {}
            updateUI();
        }

        function recalc() {
            while (currentLevel < 100 && currentXP >= getXpNeeded(currentLevel)) {
                currentXP -= getXpNeeded(currentLevel);
                currentLevel++;
            }
            if (typeof localStorage !== 'undefined') {
                localStorage.setItem('englishTrainer_xp', currentXP);
                localStorage.setItem('englishTrainer_level', currentLevel);
            }
        }

        function updateUI() {
            if (xpSpan) xpSpan.innerText = currentXP;
            if (levelSpan) levelSpan.innerText = currentLevel;
        }

        window.addXP = function(amount) {
            if (!amount) return;
            currentXP += amount;
            recalc();
            updateUI();
        };

        loadProgress();

        // маленькая анимация для XP панели (декоративная)
        const panel = document.querySelector('.xp-panel');
        if(panel) {
            panel.addEventListener('dblclick', () => {
                window.addXP(5);
                showFloatingMsg('🎁 +5 XP (пасхалка)', panel);
            });
        }

        function showFloatingMsg(text, target) {
            let div = document.createElement('div');
            div.innerText = text;
            div.style.position = 'fixed';
            div.style.background = '#4F46E5';
            div.style.color = 'white';
            div.style.padding = '6px 14px';
            div.style.borderRadius = '30px';
            div.style.fontSize = '0.8rem';
            div.style.zIndex = '999';
            div.style.pointerEvents = 'none';
            let rect = target.getBoundingClientRect();
            div.style.left = rect.left + 'px';
            div.style.top = (rect.top - 30) + 'px';
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 1000);
        }



        // ========== РЕГИСТРАЦИЯ И ВХОД ЧЕРЕЗ JSON ==========
        const authSection = document.getElementById('authSection');
        const authFormBox = document.getElementById('authFormBox');
        const authForm = document.getElementById('authForm');
        const authTabs = document.querySelectorAll('.auth-tab');
        const authName = document.getElementById('authName');
        const authEmail = document.getElementById('authEmail');
        const authPassword = document.getElementById('authPassword');
        const authSubmit = document.getElementById('authSubmit');
        const authStatus = document.getElementById('authStatus');
        const userCard = document.getElementById('userCard');
        const userName = document.getElementById('userName');
        const userEmail = document.getElementById('userEmail');
        const logoutBtn = document.getElementById('logoutBtn');
        let authMode = 'login';

        function setAuthStatus(message, type = '') {
            authStatus.textContent = message;
            authStatus.className = `auth-status ${type}`.trim();
        }

        function setAuthMode(mode) {
            authMode = mode;
            authTabs.forEach(tab => tab.classList.toggle('active', tab.dataset.mode === mode));
            authName.hidden = mode !== 'register';
            authName.required = mode === 'register';
            authPassword.autocomplete = mode === 'register' ? 'new-password' : 'current-password';
            authSubmit.textContent = mode === 'register' ? 'Зарегистрироваться' : 'Войти';
            setAuthStatus('');
        }

        function saveAuth(token, user) {
            localStorage.setItem('englishTrainer_token', token);
            localStorage.setItem('englishTrainer_user', JSON.stringify(user));
            renderUser(user);
        }

        function renderUser(user) {
            if (!user) return;
            userName.textContent = `👋 ${user.name}`;
            userEmail.textContent = user.email;
            authFormBox.hidden = true;
            userCard.hidden = false;
        }

        function clearAuth(message = '') {
            localStorage.removeItem('englishTrainer_token');
            localStorage.removeItem('englishTrainer_user');
            authFormBox.hidden = false;
            userCard.hidden = true;
            if (message) setAuthStatus(message, 'success');
        }

        async function requestJson(url, options = {}) {
            const response = await fetch(url, {
                ...options,
                headers: {
                    'Content-Type': 'application/json',
                    ...(options.headers || {})
                }
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.message || 'Ошибка запроса');
            return data;
        }

        authTabs.forEach(tab => tab.addEventListener('click', () => setAuthMode(tab.dataset.mode)));

        authForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            setAuthStatus('Отправляем JSON на сервер...');
            authSubmit.disabled = true;

            const payload = {
                email: authEmail.value.trim(),
                password: authPassword.value
            };
            if (authMode === 'register') payload.name = authName.value.trim();

            try {
                const data = await requestJson(authMode === 'register' ? '/api/register' : '/api/login', {
                    method: 'POST',
                    body: JSON.stringify(payload)
                });
                saveAuth(data.token, data.user);
                setAuthStatus(data.message, 'success');
                authForm.reset();
                showFloatingMsg('✅ ' + data.message, authSection);
            } catch (error) {
                setAuthStatus(error.message, 'error');
            } finally {
                authSubmit.disabled = false;
            }
        });

        logoutBtn.addEventListener('click', async () => {
            const token = localStorage.getItem('englishTrainer_token');
            try {
                if (token) {
                    await requestJson('/api/logout', {
                        method: 'POST',
                        headers: { Authorization: `Bearer ${token}` },
                        body: JSON.stringify({})
                    });
                }
            } finally {
                clearAuth('Вы вышли из аккаунта');
            }
        });

        async function restoreAuth() {
            const token = localStorage.getItem('englishTrainer_token');
            const cachedUser = localStorage.getItem('englishTrainer_user');
            if (cachedUser) {
                try {
                    renderUser(JSON.parse(cachedUser));
                } catch (error) {
                    clearAuth();
                }
            }
            if (!token) return;

            try {
                const data = await requestJson('/api/me', {
                    headers: { Authorization: `Bearer ${token}` }
                });
                saveAuth(token, data.user);
            } catch (error) {
                clearAuth();
            }
        }

        setAuthMode('login');
        restoreAuth();

        // ========== БУРГЕР МЕНЮ (навигация) ==========
        const burger = document.getElementById('burgerBtn');
        const sideMenu = document.getElementById('sideMenu');
        const overlay = document.getElementById('overlay');

        function closeMenu() {
            sideMenu.classList.remove('open');
            overlay.classList.remove('active');
        }

        function openMenu() {
            sideMenu.classList.add('open');
            overlay.classList.add('active');
        }

        burger.addEventListener('click', (e) => {
            e.stopPropagation();
            if (sideMenu.classList.contains('open')) closeMenu();
            else openMenu();
        });

        overlay.addEventListener('click', closeMenu);

        // пункты меню (заглушки для демонстрации навигации, дизайн не требует функционала, но я добавлю алерты, чтобы показать работу)
        const navHome = document.getElementById('navHome');
        const navAuth = document.getElementById('navAuth');
        const navGames = document.getElementById('navGames');
        const navReading = document.getElementById('navReading');
        const navAbout = document.getElementById('navAbout');
        const navCourses = document.getElementById('navCourses');

        if(navHome) navHome.addEventListener('click', (e) => { e.preventDefault(); closeMenu(); window.scrollTo({top: 0, behavior: 'smooth'}); });
        if(navAuth) navAuth.addEventListener('click', (e) => { e.preventDefault(); closeMenu(); document.getElementById('authSection').scrollIntoView({behavior: 'smooth', block: 'center'}); });
        if(navGames) navGames.addEventListener('click', (e) => { e.preventDefault(); closeMenu(); document.querySelector('.games-grid').scrollIntoView({behavior: 'smooth', block: 'start'}); });
        if(navReading) navReading.addEventListener('click', (e) => { e.preventDefault(); closeMenu(); document.querySelector('.reading-section:not([style])').scrollIntoView({behavior: 'smooth', block: 'start'}); });
        if(navAbout) navAbout.addEventListener('click', (e) => { e.preventDefault(); closeMenu(); alert('ℹ️ English Trainer — интерактивная платформа для изучения английского через игры и чтение. Создано для эффективного обучения.'); });
        if(navCourses) navCourses.addEventListener('click', (e) => { e.preventDefault(); closeMenu(); alert('🎓 Расширенные курсы: индивидуальный план, уроки с носителем, доступ к библиотеке. Скоро запуск!'); });

        // небольшие эффекты для карточек игр: при клике на игру — +XP (чисто дизайн, но пусть будет)
        const gameLinks = document.querySelectorAll('.games-grid .menu-item');
        gameLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                let gain = Math.floor(Math.random() * 12) + 6;
                window.addXP(gain);
                let msg = document.createElement('div');
                msg.innerText = `+${gain} XP`;
                msg.style.position = 'fixed';
                msg.style.bottom = '20px';
                msg.style.right = '20px';
                msg.style.background = '#10b981';
                msg.style.color = 'white';
                msg.style.padding = '6px 14px';
                msg.style.borderRadius = '40px';
                msg.style.fontWeight = 'bold';
                msg.style.zIndex = '999';
                document.body.appendChild(msg);
                setTimeout(() => msg.remove(), 800);
            });
        });
    })();
</script>
<script src="/xp.js"></script>
</body>
</html>
